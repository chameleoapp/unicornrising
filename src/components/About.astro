---
import about from '../content/site/about.json';

const composition = about.items;
---

<section class="section about" id="about">
  <div class="site-wrap">
    <p class="section__label">{about.label}</p>
    <h2 class="section__title brand-code">{about.title}</h2>
    <p class="section__lead">{about.lead}</p>

    <ol class="composition">
      {
        composition.map((item, i) => (
          <li class="composition__item">
            <span class="composition__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="composition__label brand-code">{item.label}</h3>
              <p class="composition__text">{item.text}</p>
            </div>
            {i < composition.length - 1 && (
              <span class="composition__arrow" aria-hidden="true">
                ↓
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <aside class="startup-layer">
      <p class="startup-layer__label">{about.startupLabel}</p>
      <p>{about.startupText}</p>
    </aside>
  </div>
</section>

<style>
  .composition {
    display: grid;
    gap: 0;
    margin-bottom: 1.75rem;
  }

  .composition__item {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.65rem 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--line);
  }

  .composition__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .composition__index {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 0.2rem;
  }

  .composition__label {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .composition__text {
    color: var(--fg-soft);
    max-width: 42rem;
  }

  .composition__arrow {
    position: absolute;
    left: 0.85rem;
    bottom: -0.35rem;
    color: var(--muted);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .startup-layer {
    border-left: 2px solid var(--fg);
    padding-left: 1.25rem;
    max-width: 42rem;
  }

  .startup-layer__label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
</style>
