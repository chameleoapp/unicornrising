---
import quote from '../content/site/quote.json';
---

<section class="section quote" aria-label="Quote">
  <div class="site-wrap quote__inner">
    <blockquote class="quote__text">
      <p>{quote.text}</p>
      <footer class="quote__attr">
        <cite
          >— {quote.attribution}{quote.work && <>, <em>{quote.work}</em></>}</cite
        >
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .quote {
    padding-block: clamp(2rem, 5vw, 3rem);
  }

  .quote__inner {
    max-width: 38rem;
  }

  .quote__text {
    margin: 0;
  }

  .quote__text p {
    color: var(--fg);
  }

  .quote__attr {
    margin-top: 1rem;
  }

  .quote__attr cite {
    font-style: normal;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .quote__attr em {
    font-style: italic;
  }
</style>
