---
interface Props {
  /** Official BMC button image, or a text link for footers/inline copy. */
  variant?: 'widget' | 'link';
  class?: string;
}

const { variant = 'widget', class: className } = Astro.props;
const href = 'https://www.buymeacoffee.com/ElenaArrola';
---

{
  variant === 'widget' ? (
    <a class={className} href={href}>
      <img
        src="https://img.buymeacoffee.com/button-api/?text=Feed the Unicorn&emoji=🦄&slug=ElenaArrola&button_colour=ffffff&font_colour=000000&font_family=Cookie&outline_colour=000000&coffee_colour=FFDD00"
      />
    </a>
  ) : (
    <a class={className} href={href} target="_blank" rel="noopener noreferrer">
      Feed the Unicorn
    </a>
  )
}
