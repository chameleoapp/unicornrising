---
import FeedTheUnicorn from './FeedTheUnicorn.astro';
import servicesContent from '../content/site/services.json';

const services = servicesContent.items;
---

<section class="section services" id="services">
  <div class="site-wrap">
    <p class="section__label">{servicesContent.label}</p>
    <h2 class="section__title">{servicesContent.title}</h2>
    <p class="section__lead">{servicesContent.lead}</p>

    <div class="services__list">
      {
        services.map((service) => (
          <article class="service">
            <h3 class="service__title">{service.title}</h3>
            <p class="service__text">{service.text}</p>
          </article>
        ))
      }
    </div>

    <p class="services__pay">
      {servicesContent.payNote}{' '}
      <FeedTheUnicorn variant="link" /> — or by invoice.
    </p>
  </div>
</section>

<style>
  .services__list {
    display: grid;
    gap: 0;
  }

  .service {
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .service:last-child {
    border-bottom: 1px solid var(--line);
  }

  .service__title {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .service__text {
    color: var(--fg-soft);
    max-width: 40rem;
  }

  .services__pay {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
