---
import grants from '../content/site/grants.json';
---

<section class="section grants" id="grants">
  <div class="site-wrap">
    <p class="section__label">{grants.label}</p>
    <h2 class="section__title">{grants.title}</h2>
    <p class="section__lead">{grants.lead}</p>

    <div class="grants__body">
      {grants.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="cta-row">
      <a class="btn" href={grants.primaryCtaHref}>{grants.primaryCtaLabel}</a>
      <a class="btn btn--ghost" href={grants.secondaryCtaHref}>{grants.secondaryCtaLabel}</a>
    </div>
  </div>
</section>

<style>
  .grants__body {
    display: grid;
    gap: 0.85rem;
    max-width: 40rem;
    color: var(--fg-soft);
    margin-bottom: 1.25rem;
  }
</style>
