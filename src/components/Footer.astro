---
import FeedTheUnicorn from './FeedTheUnicorn.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="site-wrap footer__inner">
    <p class="footer__brand brand-code">
      <span class="brand-code__q" aria-hidden="true">&lt;</span>train_your_unicorn<span
        class="brand-code__q"
        aria-hidden="true">&gt;</span
      >
    </p>
    <p class="footer__note">Services can be paid by invoice. Tips via Feed the Unicorn.</p>
    <div class="footer__links">
      <FeedTheUnicorn variant="link" />
    </div>
    <p class="footer__copy">&copy; {year} train_your_unicorn</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem 2.75rem;
  }

  .footer__inner {
    display: grid;
    gap: 0.65rem;
  }

  .footer__brand {
    font-size: 1.1rem;
  }

  .footer__note,
  .footer__copy {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
  }
</style>
