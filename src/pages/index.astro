---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Quote from '../components/Quote.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import EventsCalendar from '../components/EventsCalendar.astro';
import Grants from '../components/Grants.astro';
import Contact from '../components/Contact.astro';
import blogTeaser from '../content/site/blog-teaser.json';
---

<BaseLayout>
  <Hero />
  <Quote />
  <About />
  <Projects />
  <Services />
  <EventsCalendar />
  <Grants />
  <section class="section blog-teaser">
    <div class="site-wrap">
      <p class="section__label">{blogTeaser.label}</p>
      <h2 class="section__title">{blogTeaser.title}</h2>
      <p class="section__lead">{blogTeaser.lead}</p>
      <a class="btn" href={blogTeaser.ctaHref}>{blogTeaser.ctaLabel}</a>
    </div>
  </section>
  <Contact />
</BaseLayout>
