---
import FeedTheUnicorn from './FeedTheUnicorn.astro';
import contact from '../content/site/contact.json';
---

<section class="section contact" id="contact">
  <div class="site-wrap">
    <p class="section__label">{contact.label}</p>
    <h2 class="section__title">{contact.title}</h2>
    <p class="section__lead">{contact.lead}</p>

    <div class="cta-row">
      <FeedTheUnicorn />
    </div>
  </div>
</section>
