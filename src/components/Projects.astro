---
import projectsContent from '../content/site/projects.json';

const projects = projectsContent.items.map((project) => {
  let hostname: string | null = null;
  if (project.href) {
    try {
      hostname = new URL(project.href).hostname;
    } catch {
      hostname = null;
    }
  }
  return { ...project, hostname };
});
---

<section class="section projects" id="projects">
  <div class="site-wrap">
    <p class="section__label">{projectsContent.label}</p>
    <h2 class="section__title">{projectsContent.title}</h2>
    <p class="section__lead">{projectsContent.lead}</p>

    <ul class="projects__list">
      {
        projects.map((project) => (
          <li class="project">
            {project.href ? (
              <a
                class:list={['project__link', project.logo && 'project__link--logo']}
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.logo && (
                  <span class="project__mark">
                    <img
                      class="project__logo"
                      src={project.logo}
                      alt={project.logoAlt}
                      width="56"
                      height="56"
                      decoding="async"
                    />
                  </span>
                )}
                <div class="project__body">
                  <h3 class="project__name">{project.name}</h3>
                  <p class="project__text">{project.text}</p>
                  {project.hostname && <span class="project__url">{project.hostname}</span>}
                </div>
              </a>
            ) : (
              <div class:list={['project__link', project.logo && 'project__link--logo']}>
                {project.logo && (
                  <span class="project__mark">
                    <img
                      class="project__logo"
                      src={project.logo}
                      alt={project.logoAlt}
                      width="56"
                      height="56"
                      decoding="async"
                    />
                  </span>
                )}
                <div class="project__body">
                  <h3 class="project__name">{project.name}</h3>
                  <p class="project__text">{project.text}</p>
                </div>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects__list {
    display: grid;
    gap: 0;
  }

  .project {
    border-top: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project__link {
    display: grid;
    gap: 1rem 1.25rem;
    align-items: start;
    padding-block: 1.25rem;
    text-decoration: none;
  }

  .project__link--logo {
    grid-template-columns: 4.75rem 1fr;
  }

  a.project__link:hover {
    opacity: 1;
  }

  a.project__link:hover .project__name,
  a.project__link:hover .project__url {
    opacity: 0.72;
  }

  .project__mark {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 4.75rem;
    height: 2.75rem;
  }

  .project__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
  }

  .project__name {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.55rem;
    transition: opacity 0.2s var(--ease);
  }

  .project__text {
    color: var(--fg-soft);
    max-width: 40rem;
    margin-bottom: 0.55rem;
  }

  .project__url {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: opacity 0.2s var(--ease);
  }
</style>
