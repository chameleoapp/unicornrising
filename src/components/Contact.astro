---
import FeedTheUnicorn from './FeedTheUnicorn.astro';
---

<section class="section contact" id="contact">
  <div class="site-wrap">
    <p class="section__label">Contact</p>
    <h2 class="section__title">Say hello</h2>
    <p class="section__lead">
      Book a brainstorm, ask about grants, or just send a note. Services can be invoiced.
    </p>

    <div class="cta-row">
      <a class="btn" href="mailto:hello@unicornrising.example">Email</a>
      <FeedTheUnicorn />
    </div>
  </div>
</section>
