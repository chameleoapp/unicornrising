---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Quote from '../components/Quote.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import EventsCalendar from '../components/EventsCalendar.astro';
import Grants from '../components/Grants.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout>
  <Hero />
  <Quote />
  <About />
  <Projects />
  <Services />
  <EventsCalendar />
  <Grants />
  <section class="section blog-teaser">
    <div class="site-wrap">
      <p class="section__label">Blog</p>
      <h2 class="section__title">Writing from the field</h2>
      <p class="section__lead">
        Startup world, events, grants, and personal notes — published as they happen.
      </p>
      <a class="btn" href="/blog">Read the blog</a>
    </div>
  </section>
  <Contact />
</BaseLayout>
